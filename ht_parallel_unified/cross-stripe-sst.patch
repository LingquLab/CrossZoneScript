+#ifdef TILEXR_EP_HT_SST_SPLIT_WRITES
+    static constexpr uint32_t kSqStripeBbs = kSlotBytes / TileXR::TILEXR_UDMA_WQE_BB_BYTES;
+
+    __aicore__ uint32_t WaitSqStripe(uint32_t peer, uint32_t qp, __gm__ TileXR::UDMAInfo *info,
+        __gm__ TileXR::UDMAWQCtx *context, uint32_t head)
+    {
+        if (head == 0 || head % kSqStripeBbs != 0) {
+            return Success;
+        }
+        // Do not let SST combine unconsumed WQEs from two physical SQ stripes.
+        TileXR::UDMARingDoorbell(head, context);
+        return TileXR::UDMAPollCQUntilSqTail(info, peer, qp, head) ? uint32_t(TransportError) : uint32_t(Success);
+    }
+
+    __aicore__ uint32_t WaitSqStripe(uint32_t peer, uint32_t qp)
+    {
+        if (!TileXR::UDMAQueueOperationValid(args_, peer, qp)) {
+            return TransportError;
+        }
+        auto info = TileXR::GetUDMAInfo(args_);
+        auto context = TileXR::UDMAGetWQCtx(info, peer, qp);
+        if (!context || !context->headAddr || context->bufAddr % kSlotBytes != 0) {
+            return TransportError;
+        }
+        const uint32_t stripeHead = TileXR::UDMASstLoadState(reinterpret_cast<__gm__ uint32_t *>(context->headAddr));
+        return WaitSqStripe(peer, qp, info, context, stripeHead);
+    }
+#endif
