+template <AscendC::HardEvent event>
+__attribute__((always_inline)) inline __aicore__ void UDMASyncEvent()
+{
+    const auto eventId = GetTPipePtr()->FetchEventID(event);
+    AscendC::SetFlag<event>(eventId);
+    AscendC::WaitFlag<event>(eventId);
+}
+
+// The first TPipe buffer in the SST kernel reserves these 32 bytes per AIV.
+__aicore__ inline AscendC::LocalTensor<uint32_t> UDMASstStateScratch()
+{
+    return AscendC::LocalTensor<uint32_t>(AscendC::TPosition::VECCALC, 0, 8);
+}
+
+__aicore__ inline uint32_t UDMASstLoadState(__gm__ uint32_t* address)
+{
+    AscendC::GlobalTensor<uint32_t> state;
+    state.SetGlobalBuffer(address, 1);
+    state.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
+    auto scratch = UDMASstStateScratch();
+    UDMASyncEvent<AscendC::HardEvent::S_MTE2>();
+    AscendC::DataCopyPad(scratch, state, AscendC::DataCopyExtParams(1, 4, 0, 0, 0),
+        AscendC::DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
+    UDMASyncEvent<AscendC::HardEvent::MTE2_S>();
+    return scratch.GetValue(0);
+}
+
+__aicore__ inline void UDMASstStoreState(__gm__ uint32_t* address, uint32_t value)
+{
+    AscendC::GlobalTensor<uint32_t> state;
+    state.SetGlobalBuffer(address, 1);
+    state.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
+    auto scratch = UDMASstStateScratch();
+    scratch.SetValue(0, value);
+    UDMASyncEvent<AscendC::HardEvent::S_MTE3>();
+    AscendC::DataCopyPad(state, scratch, AscendC::DataCopyExtParams(1, 4, 0, 0, 0));
+    UDMASyncEvent<AscendC::HardEvent::MTE3_S>();
+}
